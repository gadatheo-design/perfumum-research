    {
      "name": "Fougère",
      "description": "Famille aromatique fraîche et verte, typiquement masculine. Caractérisée par des notes de lavande, géranium, coumarine et mousse de chêne.",
      "structure": {
        "tete": "15-25%",
        "coeur": "40-50%",
        "fond": "25-35%"
      },
      "formulas": [
        {
          "name": "Fougère Classique",
          "description": "Structure traditionnelle inspirée de Fougère Royale (1882)",
          "notes": {
            "tete": [
              { "ingredient": "Bergamote", "proportion": 10 },
              { "ingredient": "Lavande", "proportion": 15 }
            ],
            "coeur": [
              { "ingredient": "Géranium", "proportion": 20 },
              { "ingredient": "Héliotropine", "proportion": 15 },
              { "ingredient": "Clou de girofle", "proportion": 10 }
            ],
            "fond": [
              { "ingredient": "Coumarine", "proportion": 15 },
              { "ingredient": "Mousse de chêne", "proportion": 10 },
              { "ingredient": "Vétiver", "proportion": 5 }
            ]
          }
        },
        {
          "name": "Fougère Moderne",
          "description": "Version contemporaine avec notes aquatiques",
          "notes": {
            "tete": [
              { "ingredient": "Calone", "proportion": 8 },
              { "ingredient": "Lavande", "proportion": 12 }
            ],
            "coeur": [
              { "ingredient": "Géranium", "proportion": 18 },
              { "ingredient": "Salvia", "proportion": 15 },
              { "ingredient": "Ambroxan", "proportion": 12 }
