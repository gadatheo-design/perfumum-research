# Copier ce fichier en .env pour un usage STANDALONE (hors plateforme Manus).
# Voir .env.manus.example pour la liste des variables spécifiques à un
# déploiement sur Manus.

NODE_ENV=development
PORT=3000

# URL publique canonique du site. Utilisée par les citations académiques
# générées (elles sont destinées à être copiées dans des publications, donc
# à rester stables) et par le User-Agent envoyé aux API scientifiques
# (GBIF, Wikidata, Europeana). À positionner sur votre vrai domaine AVANT
# d'émettre de nouvelles citations.
PUBLIC_BASE_URL=http://localhost:3000

# Adresse de contact exposée aux API externes via le User-Agent.
# PUBLIC_CONTACT_EMAIL=research@perfumum.art

# Lot 3 — force le build/dev en mode standalone : aucune injection du
# runtime Manus, aucun script Manus dans le HTML généré.
PERFUMUM_PLATFORM=standalone

# Base de données (MySQL/TiDB compatible)
DATABASE_URL=mysql://user:password@host:4000/perfumum

# Authentification / session (obligatoire, aucune valeur par défaut sûre)
JWT_SECRET=change-me-generate-a-real-secret

# ------------------------------------------------ connexion (mode standalone)
# Générer l'empreinte avec :  node deploy/hash-password.mjs
# Les apostrophes sont nécessaires : l'empreinte contient des caractères $.
ADMIN_EMAIL=vous@example.org
ADMIN_PASSWORD_HASH='scrypt$65536$8$1$...'
ADMIN_NAME=Administrateur

# Durée de session en jours (30 par défaut, 365 maximum).
# SESSION_LIFETIME_DAYS=30

# ------------------------------------------------------ stockage de fichiers
# "manus" (défaut), "local", "s3" ou "disabled".
# Les URLs renvoyées sont relatives (/files/<clé>) et résolues à la demande :
# elles restent valides même si vous changez de domaine ou de fournisseur.
STORAGE_PROVIDER=local

# Requis si STORAGE_PROVIDER=local. Doit être un volume PERSISTANT :
# sur un système de fichiers éphémère, les fichiers disparaissent au
# redéploiement.
STORAGE_LOCAL_DIR=/app/uploads

# Requis si STORAGE_PROVIDER=s3 (compatible R2, Backblaze, MinIO,
# Infomaniak Swiss Object Storage).
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.exemple.net
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Notifications : "manus" ou "disabled". En standalone le défaut est
# "disabled" — les notifications sont journalisées sans faire échouer
# l'action qui les déclenche.
# NOTIFICATION_PROVIDER=disabled

# Fournisseur LLM (Lot 4) — "manus" (défaut), "openai" ou "disabled".
# En standalone, choisir "openai" (endpoint compatible OpenAI) ou
# "disabled" (invokeLLM() lève une erreur avant tout appel réseau, aucune
# clé requise). "manus" reste utilisable en standalone si vous avez accès
# à un endpoint Forge, mais n'a normalement de sens qu'en déploiement Manus.
LLM_PROVIDER=disabled

# Requis seulement si LLM_PROVIDER=openai
# OPENAI_API_URL=https://api.openai.com
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Requis seulement si LLM_PROVIDER=manus
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Europeana (optionnel, utilisé par certains routeurs d'enrichissement)
# EUROPEANA_API_KEY=

# Google Analytics (optionnel, front-end)
# VITE_GA_MEASUREMENT_ID=
