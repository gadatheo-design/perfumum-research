# ==============================================================================
# PERFUMUM — variables de la stack Docker
#
# Copier en `.env` À LA RACINE DU PROJET sur le VPS, puis restreindre l'accès :
#   cp .env.docker.example .env && chmod 600 .env
#
# Ce fichier contient des secrets : il ne doit JAMAIS être versionné.
# `.gitignore` exclut déjà `.env`.
# ==============================================================================

# ----------------------------------------------------------------- domaine --
# Doit pointer vers l'IP du VPS AVANT le premier démarrage : Caddy demande un
# certificat Let's Encrypt au lancement, et la validation échoue sinon.
DOMAIN=perfumum.example
ACME_EMAIL=vous@example.org

# URL publique canonique. Sert aux citations académiques générées et au
# User-Agent envoyé aux API scientifiques. Doit correspondre à DOMAIN.
PUBLIC_BASE_URL=https://perfumum.example
PUBLIC_CONTACT_EMAIL=research@perfumum.example

# ---------------------------------------------------------------- secrets ---
# Générer chaque valeur séparément, par exemple :
#   openssl rand -base64 36
MYSQL_ROOT_PASSWORD=CHANGEZ_MOI_mot_de_passe_root
MYSQL_PASSWORD=CHANGEZ_MOI_mot_de_passe_applicatif
JWT_SECRET=CHANGEZ_MOI_secret_de_session

# Changer JWT_SECRET invalide toutes les sessions en cours : les utilisateurs
# devront se reconnecter. C'est le levier à utiliser en cas de compromission.

MYSQL_DATABASE=perfumum
MYSQL_USER=perfumum

# ------------------------------------------------------------------- image --
# En local, l'image est construite par `docker compose build`.
# Si le build est fait en intégration continue, pointer ici l'image publiée :
#   APP_IMAGE=ghcr.io/gadatheo-design/perfumum:latest
APP_IMAGE=perfumum:local

# --------------------------------------------------------------------- IA ---
# "disabled" (défaut) : invokeLLM() lève une erreur avant tout appel réseau.
# "openai" : renseigner la clé et éventuellement le modèle.
LLM_PROVIDER=disabled
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------- API scientifiques --
# Optionnel : sans clé, les routeurs concernés renvoient une erreur explicite
# plutôt que de planter.
# EUROPEANA_API_KEY=
