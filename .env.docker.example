# ==============================================================================
# PERFUMUM — variables de la stack Docker
#
# Copier en `.env` À LA RACINE DU PROJET sur le VPS, puis restreindre l'accès :
#   cp .env.docker.example .env && chmod 600 .env
#
# Ce fichier contient des secrets : il ne doit JAMAIS être versionné.
# `.gitignore` exclut déjà `.env`.
# ==============================================================================

# ----------------------------------------------------------------- domaine --
# Doit pointer vers l'IP du VPS AVANT le premier démarrage : Caddy demande un
# certificat Let's Encrypt au lancement, et la validation échoue sinon.
DOMAIN=perfumum.example
ACME_EMAIL=vous@example.org

# URL publique canonique. Sert aux citations académiques générées et au
# User-Agent envoyé aux API scientifiques. Doit correspondre à DOMAIN.
PUBLIC_BASE_URL=https://perfumum.example
PUBLIC_CONTACT_EMAIL=research@perfumum.example

# ---------------------------------------------------------------- secrets ---
# Générer chaque valeur séparément, par exemple :
#   openssl rand -base64 36
MYSQL_ROOT_PASSWORD=CHANGEZ_MOI_mot_de_passe_root
MYSQL_PASSWORD=CHANGEZ_MOI_mot_de_passe_applicatif
JWT_SECRET=CHANGEZ_MOI_secret_de_session

# Changer JWT_SECRET invalide toutes les sessions en cours : les utilisateurs
# devront se reconnecter. C'est le levier à utiliser en cas de compromission.

MYSQL_DATABASE=perfumum
MYSQL_USER=perfumum

# ------------------------------------------------------------------- image --
# En local, l'image est construite par `docker compose build`.
# Si le build est fait en intégration continue, pointer ici l'image publiée :
#   APP_IMAGE=ghcr.io/gadatheo-design/perfumum:latest
APP_IMAGE=perfumum:local

# ------------------------------------------------ connexion (mode standalone)
# Générer l'empreinte avec :  node deploy/hash-password.mjs
# Les apostrophes sont nécessaires : l'empreinte contient des caractères $.
ADMIN_EMAIL=vous@example.org
ADMIN_PASSWORD_HASH='scrypt$65536$8$1$...'
ADMIN_NAME=Administrateur

# Durée de session en jours (30 par défaut, 365 maximum).
# SESSION_LIFETIME_DAYS=30

# ------------------------------------------------------ stockage de fichiers
# "manus" (défaut), "local", "s3" ou "disabled".
# Les URLs renvoyées sont relatives (/files/<clé>) et résolues à la demande :
# elles restent valides même si vous changez de domaine ou de fournisseur.
STORAGE_PROVIDER=local

# Requis si STORAGE_PROVIDER=local. Doit être un volume PERSISTANT :
# sur un système de fichiers éphémère, les fichiers disparaissent au
# redéploiement.
STORAGE_LOCAL_DIR=/app/uploads

# Requis si STORAGE_PROVIDER=s3 (compatible R2, Backblaze, MinIO,
# Infomaniak Swiss Object Storage).
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.exemple.net
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Notifications : "manus" ou "disabled". En standalone le défaut est
# "disabled" — les notifications sont journalisées sans faire échouer
# l'action qui les déclenche.
# NOTIFICATION_PROVIDER=disabled

# ------------------------------------------------------------ journalisation
# Niveau : debug, info (défaut en production), warn, error.
# LOG_LEVEL=info
# Format : "json" (défaut en production, exploitable par un collecteur) ou
# "pretty" (lisible, défaut en développement).
# LOG_FORMAT=json

# --------------------------------------------------------------------- IA ---
# "disabled" (défaut) : invokeLLM() lève une erreur avant tout appel réseau.
# "openai" : renseigner la clé et éventuellement le modèle.
LLM_PROVIDER=disabled
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------- API scientifiques --
# Optionnel : sans clé, les routeurs concernés renvoient une erreur explicite
# plutôt que de planter.
# EUROPEANA_API_KEY=
