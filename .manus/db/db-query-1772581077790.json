  "query": "\nSELECT \n  LOWER(TRIM(name)) as name_normalized,\n  COUNT(*) as nb_doublons,\n  MIN(id) as id_keep,\n  MAX(id) as id_remove,\n  GROUP_CONCAT(id ORDER BY id SEPARATOR ', ') as all_ids\nFROM molecules\nGROUP BY LOWER(TRIM(name))\nHAVING COUNT(*) > 1\nORDER BY nb_doublons DESC\nLIMIT 50;\n",
