  "query": "\nSELECT \n  m.id,\n  m.name,\n  m.cas_number,\n  m.chemical_class,\n  m.family,\n  (SELECT COUNT(*) FROM plant_molecules pm WHERE pm.molecule_id = m.id) as plant_links,\n  (SELECT COUNT(*) FROM molecules_recettes mr WHERE mr.molecule_id = m.id) as recipe_links\nFROM molecules m\nWHERE LOWER(TRIM(m.name)) IN (\n  SELECT LOWER(TRIM(name)) FROM molecules GROUP BY LOWER(TRIM(name)) HAVING COUNT(*) > 1\n)\nORDER BY LOWER(TRIM(m.name)), m.id;\n",
