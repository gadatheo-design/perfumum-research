{
  "_comment": "Configuration TypeScript allégée pour tsc --watch en développement.",
  "_reason": "Le tsconfig.json principal inclut 728 fichiers (dont 311 pages frontend avec @ts-nocheck),",
  "_reason2": "ce qui provoque une consommation mémoire de 2,28 Go. Ce fichier réduit la portée",
  "_reason3": "à l'essentiel : serveur, schéma DB, types partagés et composants critiques.",
  "_usage": "Utilisé automatiquement par `pnpm check` via package.json.",
  "include": [
    "server/**/*",
    "shared/**/*",
    "drizzle/**/*",
    "client/src/lib/**/*",
    "client/src/hooks/**/*",
    "client/src/contexts/**/*",
    "client/src/components/ui/**/*",
    "client/src/components/layout/**/*",
    "client/src/App.tsx",
    "client/src/main.tsx"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "client/src/pages/**/*",
    "client/src/components/A*.tsx",
    "client/src/components/B*.tsx",
    "client/src/components/C*.tsx",
    "client/src/components/D*.tsx",
    "client/src/components/E*.tsx",
    "client/src/components/F*.tsx",
    "client/src/components/G*.tsx",
    "client/src/components/H*.tsx",
    "client/src/components/I*.tsx",
    "client/src/components/J*.tsx",
    "client/src/components/K*.tsx",
    "client/src/components/L*.tsx",
    "client/src/components/M*.tsx",
    "client/src/components/N*.tsx",
    "client/src/components/O*.tsx",
    "client/src/components/P*.tsx",
    "client/src/components/Q*.tsx",
    "client/src/components/R*.tsx",
    "client/src/components/S*.tsx",
    "client/src/components/T*.tsx",
    "client/src/components/U*.tsx",
    "client/src/components/V*.tsx",
    "client/src/components/W*.tsx",
    "client/src/components/X*.tsx",
    "client/src/components/Y*.tsx",
    "client/src/components/Z*.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo-check",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
