{
  // Vérification de types du dépôt.
  //
  // Historiquement, TOUT client/src/pages et TOUS les composants de A à Z
  // étaient exclus, pour des raisons de mémoire. Conséquence : `pnpm check`
  // passait au vert sans vérifier une seule page ni un seul composant.
  //
  // Mesuré depuis : un typecheck complet du client atteint ~3,0 Go, ce que
  // couvre largement l'allocation de 8 Go du script `check`. L'exclusion
  // n'était donc plus justifiée.
  //
  // Les 74 fichiers encore en erreur conservent un `// @ts-nocheck` : ils
  // restent dans le périmètre de vérification, mais leurs erreurs sont
  // suppressées fichier par fichier. Le compte se retrouve d'une commande —
  //   grep -rl "@ts-nocheck" client/
  // — et doit décroître, jamais augmenter.
  "include": [
    "server/**/*",
    "shared/**/*",
    "drizzle/**/*",
    "client/src/lib/**/*",
    "client/src/hooks/**/*",
    "client/src/contexts/**/*",
    "client/src/components/ui/**/*",
    "client/src/components/layout/**/*",
    "client/src/App.tsx",
    "client/src/main.tsx"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "server/**/*.test.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo-check",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "target": "ES2022"
  }
}
