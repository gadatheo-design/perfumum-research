# Copier ce fichier en .env pour un déploiement sur la plateforme MANUS.
# "manus" est la valeur PAR DÉFAUT de PERFUMUM_PLATFORM : la ligne ci-dessous
# est explicite mais pas strictement nécessaire si la variable est absente.

NODE_ENV=production
PERFUMUM_PLATFORM=manus

# URL publique canonique (citations académiques + User-Agent sortant).
# Si absente, le code retombe sur https://perfumum.manus.space.
PUBLIC_BASE_URL=https://perfumum.manus.space

# Adresse de contact exposée aux API externes via le User-Agent.
# PUBLIC_CONTACT_EMAIL=research@perfumum.art

# Identité de l'application sur Manus / OAuth
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Fournisseur LLM (Lot 4) — "manus" est le défaut si la variable est
# absente ; explicite ici par clarté.
LLM_PROVIDER=manus

# Forge (LLM proxy Manus) — utilisé côté serveur
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=

# Forge — variables exposées côté client (voir Registre des risques du
# rapport d'audit : VITE_FRONTEND_FORGE_API_KEY est lue en clair dans
# client/src/components/Map.tsx, donc visible dans le bundle livré au
# navigateur, quelle que soit sa valeur)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Base de données (MySQL/TiDB compatible)
DATABASE_URL=

# Authentification / session
JWT_SECRET=

# Europeana (optionnel, utilisé par certains routeurs d'enrichissement)
EUROPEANA_API_KEY=

# Google Analytics (optionnel, front-end)
VITE_GA_MEASUREMENT_ID=
